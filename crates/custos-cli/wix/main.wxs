            <Component Id="DocGuideRoadmap" Guid="E7EBFC25-FB5D-6DAC-B739-B26A25968CEF">
              <File Id="DocGuideRoadmapFile" Source="docs\guide\roadmap.md" KeyPath="yes" />
            </Component>
            <Component Id="DocGuideSecurity" Guid="82B2B375-5CA7-1A40-7CAA-BE5CA874CEEB">
              <File Id="DocGuideSecurityFile" Source="docs\guide\security.md" KeyPath="yes" />
            </Component>
            <Component Id="DocGuideTesting" Guid="801F4137-659E-C5CD-A8A3-13DCC59A3CAD">
              <File Id="DocGuideTestingFile" Source="docs\guide\testing.md" KeyPath="yes" />
            </Component>
            <Component Id="DocGuideWorkspace" Guid="9306764A-E452-7C50-DB9B-5687F88CE3C1">
              <File Id="DocGuideWorkspaceFile" Source="docs\guide\workspace.md" KeyPath="yes" />
            </Component>
            </Directory>
            <Directory Id="DocsZhFolder" Name="zh">
              <Directory Id="DocsZhGuideFolder" Name="guide">
            <Component Id="DocZhGuideAdrprinciples" Guid="FBA0F4B5-756C-48A8-E88B-C34A5510D642">
