<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Custos" Language="1033" Version="0.1.0" Manufacturer="cuihairu" UpgradeCode="F8D4A5C3-2B9E-4D8A-BE7C-6E1F8D3A7B42">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
    <MediaTemplate EmbedCab="yes" />
    <!-- Application icon: converted from the official SVG brand asset
         (docs/public/logo.svg) by scripts/make-windows-icon.py. Shown in
         Add/Remove Programs and on shortcuts. The same .ico is embedded
         into both exes at build time (crates/*/build.rs). -->
    <Icon Id="CustosIcon" SourceFile="assets\icons\custos.ico" />
    <Property Id="ARPPRODUCTICON" Value="CustosIcon" />
    <Feature Id="ProductFeature" Title="Custos" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="TrayExecutable" />
      <ComponentRef Id="CustosLicense" />
      <ComponentRef Id="CustosReadme" />
      <ComponentRef Id="CustosReadmeZh" />
      <ComponentRef Id="ExampleBasicProcess" />
      <ComponentRef Id="ExampleDependencyChain" />
      <ComponentRef Id="ExampleNotifications" />
      <ComponentRef Id="DocsIndex" />
