      <ComponentRef Id="DocZhGuideOverview" />
      <ComponentRef Id="DocZhGuidePersistence" />
      <ComponentRef Id="DocZhGuidePlatforms" />
      <ComponentRef Id="DocZhGuidePlugins" />
      <ComponentRef Id="DocZhGuideProbediagnosis" />
      <ComponentRef Id="DocZhGuideProbesurvey" />
      <ComponentRef Id="DocZhGuideRecoveryengine" />
      <ComponentRef Id="DocZhGuideResources" />
