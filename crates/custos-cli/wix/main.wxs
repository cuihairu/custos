      <ComponentRef Id="DocZhGuideSecurity" />
      <ComponentRef Id="DocZhGuideTesting" />
      <ComponentRef Id="DocZhGuideWorkspace" />
    </Feature>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Custos">
          <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-4789-AB12-CD34EF56AB01">
            <File Id="CustosExe" Name="custos.exe" Source="$(var.CargoTargetBinDir)\custos.exe" KeyPath="yes" />
            <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
          </Component>
          <Component Id="TrayExecutable" Guid="B2C3D4E5-F6A7-4BCD-8912-EF34AB56CD02">
            <File Id="CustosTrayExe" Name="custos-tray.exe" Source="$(var.CargoTargetBinDir)\custos-tray.exe" />
          </Component>
          <!-- LICENSE + READMEs at the install root. -->
            <Component Id="CustosLicense" Guid="9B37CC19-FD39-A350-1CF0-2EC0AABBAE23">
              <File Id="CustosLicenseFile" Source="LICENSE" KeyPath="yes" />
            </Component>
            <Component Id="CustosReadme" Guid="11784A32-912E-8305-F645-87C29AD45D50">
              <File Id="CustosReadmeFile" Source="README.md" KeyPath="yes" />
            </Component>
            <Component Id="CustosReadmeZh" Guid="0F61393F-DDCE-4FA4-5687-789F17155415">
              <File Id="CustosReadmeZhFile" Source="README.zh.md" KeyPath="yes" />
            </Component>
          <!-- Sample configurations (examples/): shipped so users can
               validate/start from a working example
               (`custos validate examples\basic-process.toml`).
               NOTE: keep in sync with examples/*.toml. -->
          <Directory Id="ExamplesFolder" Name="examples">
            <Component Id="ExampleBasicProcess" Guid="72374CEB-6F30-DD5D-40EE-60684032DE87">
              <File Id="ExampleBasicProcessFile" Source="examples\basic-process.toml" KeyPath="yes" />
            </Component>
            <Component Id="ExampleDependencyChain" Guid="4EF5EFDD-AA25-CFE5-A37A-10C45270F5E3">
              <File Id="ExampleDependencyChainFile" Source="examples\dependency-chain.toml" KeyPath="yes" />
            </Component>
            <Component Id="ExampleNotifications" Guid="244C1F3D-E95A-25C0-90B8-B62B1F39816A">
              <File Id="ExampleNotificationsFile" Source="examples\notifications.toml" KeyPath="yes" />
            </Component>
          </Directory>
          <!-- Offline docs snapshot (markdown, not the built site):
               version-matched guide readable without network; mirrors the
               zip/tar/dmg layout. NOTE: keep in sync with docs/guide/*.md
               (a new guide file needs a Component entry here). -->
          <Directory Id="DocsFolder" Name="docs">
            <Component Id="DocsIndex" Guid="4804396D-34EA-2DDD-FF8A-61E9F1DCCC6E">
              <File Id="DocsIndexFile" Source="docs\index.md" KeyPath="yes" />
            </Component>
            <Directory Id="DocsGuideFolder" Name="guide">
            <Component Id="DocGuideAdrprinciples" Guid="6B70564C-069B-3BAF-6EC3-E7A9690C8ADD">
